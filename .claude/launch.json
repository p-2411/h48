{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "waitlist-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd waitlist && WAITLIST_STORE=file NEXT_PUBLIC_SITE_URL=http://localhost:3100 pnpm start -p 3100"],
      "port": 3100
    },
    {
      "name": "waitlist-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd waitlist && pnpm dev -p 3000"],
      "port": 3000
    }
  ]
}
