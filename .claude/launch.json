{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "waitlist",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "waitlist/dev-server.cjs"
      ],
      "port": 4321
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=waitlist/.env.local",
        "waitlist/scripts/dashboard.js"
      ],
      "port": 4400
    },
    {
      "name": "home-design",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "app/node_modules/vite/bin/vite.js",
        "--config",
        "app/design-preview/vite.config.mjs"
      ],
      "port": 5199
    },
    {
      "name": "onboarding-design",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "app/node_modules/vite/bin/vite.js",
        "docs/design",
        "--port",
        "5300",
        "--strictPort"
      ],
      "port": 5300
    },
    {
      "name": "duet-mascot",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "app/node_modules/vite/bin/vite.js",
        "--config",
        "app/design-preview/vite.config.mjs",
        "--port",
        "5198"
      ],
      "port": 5198
    }
  ]
}
