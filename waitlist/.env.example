# Copy to .env.local for local overrides. On Vercel, set these in Project Settings > Environment Variables. Never commit real values.
# Optional values are commented out on purpose: an empty value (FOO=) is not the same as unset, so uncomment a line only to fill it.

# Neon Postgres connection string (Sydney, aws-ap-southeast-2). Unset locally = sign-ups go to .data/waitlist.json; required in production.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# Public site URL, no trailing slash. Used for canonical links, Open Graph, robots.txt, the sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email shown in the footer, the privacy policy and "Who's building this".
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Privacy email for access, correction, deletion and complaints. Falls back to NEXT_PUBLIC_CONTACT_EMAIL when unset.
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com

# Legal entity name for the footer disclaimer and the privacy policy. Leave unset until the entity exists.
# NEXT_PUBLIC_LEGAL_NAME=Example Solar Pty Ltd

# ABN shown after the legal name (only when NEXT_PUBLIC_LEGAL_NAME is set). Leave unset until issued.
# NEXT_PUBLIC_ABN=12 345 678 901

# Secret salt for the one-way IP hash in each consent record. Set a long random value in production (openssl rand -hex 32) and keep it stable.
# IP_HASH_SALT=
