# Copy this file to .env.local. Never commit a real project key.
OPENAI_API_KEY=

# Optional GPT-Live overrides.
DUET_LIVE_VOICE=marin
DUET_LIVE_BACKEND_MODEL=gpt-6-luna

# Optional: saying a line back (the daily session, checkpoints). Duet says it with this model (in
# DUET_LIVE_VOICE), and hears the learner with the other.
DUET_TTS_MODEL=gpt-4o-mini-tts
DUET_COACH_MODEL=gpt-audio-1.5

# Demos only: seeds two labelled Japanese cards into an empty duet.db, opens the tutor at launch,
# and uses a Japanese demo line when no line is on screen.
DUET_DEMO_FIXTURES=0
